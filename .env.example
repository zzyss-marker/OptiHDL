# OptiHDL Environment Configuration
# Copy this file to .env and fill in your values

# LLM Mode: api / local / auto
OPTIHDL_LLM_MODE=api

# API Configuration (required when LLM_MODE=api)
OPTIHDL_API_BASE_URL=http://127.0.0.1:8000/v1
OPTIHDL_API_KEY=your-api-key-here
OPTIHDL_API_MODEL=qwen2.5-coder
